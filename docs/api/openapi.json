          "401": {
            "description": "API_KEY_REQUIRED / API_KEY_INVALID / API_KEY_EXPIRED"
          },
          "403": {
            "description": "INSUFFICIENT_SCOPE (needs read:contacts) or TIER_LOCKED"
          },
          "404": {
            "description": "Not found in the key's company"
          },
          "429": {
            "description": "API_KEY_RATE_LIMITED (see Retry-After)"
          }
        }
      },
      "post": {
        "summary": "Create a customer contact",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-required-scope": "write:contacts",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The contact"
          },
          "400": {
            "description": "VALIDATION_ERROR (unknown keys are rejected)"
          },
          "401": {
            "description": "API_KEY_REQUIRED / API_KEY_INVALID / API_KEY_EXPIRED"
          },
          "403": {
            "description": "INSUFFICIENT_SCOPE (needs write:contacts) or TIER_LOCKED"
          },
          "404": {
            "description": "Not found in the key's company"
          },
          "429": {
            "description": "API_KEY_RATE_LIMITED (see Retry-After)"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "nameAr": {
                    "type": "string",
                    "nullable": true
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 320,
                    "nullable": true
                  },
                  "phone": {
                    "type": "string",
                    "nullable": true
                  },
                  "trnNumber": {
                    "type": "string",
                    "pattern": "^\\d{15}$",
                    "nullable": true
                  },
                  "address": {
                    "type": "string",
                    "nullable": true
                  },
                  "city": {
                    "type": "string",
                    "nullable": true
                  },
                  "country": {
                    "type": "string",
                    "nullable": true
                  },
                  "emirate": {
                    "type": "string",
                    "enum": [
                      "abu_dhabi",
                      "dubai",
                      "sharjah",
                      "ajman",
                      "umm_al_quwain",
                      "ras_al_khaimah",
                      "fujairah"
                    ],
                    "nullable": true
                  },
                  "paymentTerms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 365
                  }
                },
                "required": ["name"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
