          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ data: Contact[], limit, offset }"
          },
          "400": {
            "description": "VALIDATION_ERROR (unknown keys are rejected)"
