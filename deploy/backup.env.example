# Copy to /etc/muhasib/backup.env (mode 600). Read by scripts/ops/backup.sh and restore-drill.sh.
# Data residency: customer data stays in the UAE, so the off-site target MUST be a UAE location.
BACKUP_DIR=/srv/muhasib/backups
UPLOADS_DIR=/srv/muhasib/uploads
AGE_RECIPIENTS_FILE=/etc/muhasib/backup.pub
DB_CONTAINER=muhasib-db-1
DB_USER=muhasib
DB_NAME=muhasib
LOCAL_RETENTION_DAYS=14
# rclone remote:path of a UAE-region location (UAE object-storage bucket, or an SFTP host at a second UAE site).
OFFSITE_REMOTE=uae-offsite:muhasib-backups
# You must state the region of OFFSITE_REMOTE. The script refuses to run unless this is exactly "uae".
OFFSITE_REGION=uae
# Optional dead-man switch URL (an uptime monitor receives only a ping, no customer data).
# HEALTHCHECK_URL=
