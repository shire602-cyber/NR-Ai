# ============================================
# Muhasib.ai Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.

# === Required ===
DATABASE_URL=postgresql://user:password@host:5432/muhasib_db
SESSION_SECRET=your-session-secret-at-least-32-characters-long
JWT_SECRET=your-jwt-secret-at-least-32-characters-long-different-from-session

# === Server ===
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of additional allowed browser origins for split frontend/backend deployments.
# CORS_ORIGIN=http://localhost:5173,https://app.example.com
# Production default is SameSite=None so separate frontend/backend origins can keep sessions.
# AUTH_COOKIE_SAMESITE=none

# === AI (OpenAI API) ===
OPENAI_API_KEY=sk-your-openai-api-key
AI_MODEL=gpt-3.5-turbo

# === Google Sheets Integration (Option 1: Service Account) ===
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === Google Sheets Integration (Option 2: OAuth2) ===
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# === UAE e-invoicing (Accredited Service Provider) ===
# Under Ministerial Decision 64/2025 only an MoF-accredited service provider may
# transmit UAE e-invoices. Muhasib generates compliant PINT AE / UBL 2.1 XML and
# hands it to that provider.
#
# "mock" fabricates an acceptance response — fine for dev and tests, and REFUSED
# in production so nobody can believe an invoice was transmitted when it wasn't.
#
# To go live: sign with an accredited ASP, then set EINVOICE_PROVIDER to one of
# acube | complyance (see docs/einvoicing-providers.md) plus that provider's
# credentials. There is no default provider: leave it empty until one is chosen.
EINVOICE_PROVIDER=
# EINVOICE_API_BASE_URL=https://api.your-asp.ae/v1
# EINVOICE_API_KEY=your-asp-api-key
# EINVOICE_API_AUTH_STYLE=bearer      # bearer (default) | header
# EINVOICE_API_KEY_HEADER=x-api-key   # used when auth style = header
# EINVOICE_API_TIMEOUT_MS=20000

# === Logging ===
LOG_LEVEL=info

# === Billing & Webhooks ===
# Billing tier enforcement. Default: automatic — production enforces tiers
# once Stripe is configured, and runs open (with a startup warning) before
# that, so pre-billing betas need no flag. Set true/false to override in
# either direction. Non-production defaults to open.
# Pre-billing beta switch: BILLING_ENFORCEMENT=false is the ONLY way to keep paid features
# open in production once Stripe is configured; keep it explicit. While enforcement is on,
# gates fail closed: every company has a Free subscription row (created on company creation,
# backfilled by migration 0113) and a missing row also resolves to Free. NR-managed client
# books (company_type=client) are firm-billed and exempt from plan gates.
# BILLING_ENFORCEMENT=true
# Allow webhook URLs pointing at private/loopback addresses (self-hosted or
# local webhook receivers only — disables SSRF range checks).
# WEBHOOK_ALLOW_PRIVATE_URLS=false

# === Rate limits (requests per minute per ip:user; see server/middleware/rateLimit.ts) ===
# RL_API_MAX=100        # writes
# RL_READ_MAX=600       # GET/HEAD
# RL_AUTH_MAX=5         # failed credential attempts
# RL_AI_MAX=20
# The live-server integration scripts (tests/integration/*.mjs) read the same
# RL_* values and wait out 429s using Retry-After instead of skipping.

# === Test harness (npm run test:db) ===
# Admin URL used to CREATE/DROP per-run harness_* databases. Defaults to this
# file's DATABASE_URL with the database name replaced by "postgres". The harness
# never loads .env into the app and never touches the database named above.
# TEST_DATABASE_ADMIN_URL=postgresql://user:password@localhost:5432/postgres
# HARNESS_MAX_WORKERS=2
# HARNESS_LOG_LEVEL=fatal

# ─── Identity, RBAC and throttling (W2-C) ────────────────────────────
# Reverse-proxy hops in front of the app, used for req.ip and per-IP rate
# limits. Railway/Render: 1. CDN + load balancer: 2. Directly reachable: 0
# (X-Forwarded-For ignored). An Express trust list such as
# "loopback, 10.0.0.0/8" also works. "true" is refused. Unset = 1, with a
# warning in production.
# TRUST_PROXY_HOPS=1
# Central company-role policy (server/middleware/companyRolePolicy.ts).
# enforce (default) | report (log what would be denied, deny nothing) | off.
# Staged rollout: deploy with report, review "RBAC (report mode)" logs,
# then switch to enforce.
# RBAC_ENFORCE=enforce
# Per email+IP sign-in lockout: 5 failures in 15 min, then 10 in 1 h.
# RL_LOGIN_LOCK_MAX=5
# RL_LOGIN_LOCK_WINDOW_MS=900000
# RL_LOGIN_LOCK_LONG_MAX=10
# RL_LOGIN_LOCK_LONG_WINDOW_MS=3600000
# Optional override for the offline common-password list (top 10k).
# COMMON_PASSWORDS_FILE=server/assets/common-passwords.txt

# ─── External integrations added in waves 3-4 (all optional) ─────────
# None of these is required to boot. Each feature reports its honest status
# (requires_external / 503 *_NOT_CONFIGURED) until its variables are set.

# --- UAE e-invoicing ASP (W4-C) — server/services/einvoice-provider-http.ts ---
# EINVOICE_API_* names above are accepted as legacy aliases of EINVOICE_ASP_*.
# EINVOICE_ASP_BASE_URL=https://sandbox.example-asp.ae/v1
# EINVOICE_ASP_API_KEY=asp-api-key-or-user:password
# EINVOICE_ASP_ENV=sandbox              # sandbox | production
# EINVOICE_ASP_AUTH_SCHEME=bearer       # bearer | header | basic
# EINVOICE_ASP_KEY_HEADER=x-api-key     # used by the "header" scheme
# EINVOICE_ASP_MAPPING_FILE=/app/config/asp-mapping.json   # per-ASP request/response mapping
# EINVOICE_ASP_TIMEOUT_MS=20000
# HMAC secret for POST /api/webhooks/einvoice/:companyId/inbound (unset => 503).
# EINVOICE_INBOUND_WEBHOOK_SECRET=
# --- A-Cube (E1, MoF-accredited ASP no. 188961) — server/services/einvoice/providers/acube.ts ---
# Each company chooses its provider in E-invoicing settings. Provision its encrypted credential
# bundle through the runtime secret store. See docs/einvoicing-company-runtime.md.
# ACUBE_ENV=sandbox                     # sandbox (ae-sandbox.api.acubeapi.com) | production
# ACUBE_INVOICE_SUBMIT_PATH=/invoices/outgoing       # docs also show /invoices; confirm in sandbox
# ACUBE_CREDIT_NOTE_SUBMIT_PATH=/credit-notes/outgoing
# ACUBE_TIMEOUT_MS=20000
# Public https base A-Cube calls back (webhook target and signature @target-uri).
# ACUBE_WEBHOOK_BASE_URL=https://app.example.com
# ACUBE_WEBHOOK_TOKEN_HEADER=X-Acube-Token
# ACUBE_SIGNATURE_PUBLIC_KEY=           # pin A-Cube's Ed25519 key (PEM); default: fetched + cached
# ACUBE_WEBHOOK_MAX_AGE_SECONDS=43200   # signature age window (A-Cube retries for ~10 h)
# --- Complyance (E2, MoF-accredited ASP no. 112219) — server/services/einvoice/providers/complyance.ts ---
# Credentials also use an encrypted company bundle. See docs/einvoicing-company-runtime.md.
# COMPLYANCE_ENV=sandbox                # sandbox | production
# COMPLYANCE_BASE_URL=https://prod.gets.complyance.io   # same host for both environments
# COMPLYANCE_SUBMIT_FORMAT=gets         # gets (Default GETS Mapping) | xml (custom XML mapping)
# COMPLYANCE_SOURCE_PREFIX=muhasib      # per-company invoice source: <prefix>-<companyId>:<version>
# COMPLYANCE_SOURCE_VERSION=v1
# COMPLYANCE_USER_AGENT=Muhasib-EInvoicing/1.0   # required by Complyance's WAF
# COMPLYANCE_TIMEOUT_MS=30000
# COMPLYANCE_POLL_DAYS=3                # purchase listing window for the poll fallback
# Public https base Complyance calls back (for the webhook URL shown in settings).
# COMPLYANCE_WEBHOOK_BASE_URL=https://app.example.com
# COMPLYANCE_WEBHOOK_ALGORITHM=sha256   # sha256 | sha512, as chosen when creating the webhook
# COMPLYANCE_WEBHOOK_MAX_AGE_SECONDS=3600
# EINVOICE_REPORT_WINDOW_DAYS=14        # report-by date = invoice date + N days (confirm with FTA)
# Vendored UBL 2.1 XSD + PINT AE schematron; defaults to server/assets/einvoice.
# EINVOICE_ARTEFACTS_DIR=/app/server/assets/einvoice

# --- Online invoice payment (W4-D) — server/services/payments ---
# INVOICE_PAYMENTS_ENABLED=false
# INVOICE_PAYMENTS_PROVIDER=stripe      # stripe | telr | ngenius (Telr / N-Genius: requires_external)
# STRIPE_SECRET_KEY=sk_test_...         # also used by SaaS billing
# STRIPE_WEBHOOK_SECRET=whsec_...       # SaaS billing webhook
# STRIPE_INVOICE_WEBHOOK_SECRET=whsec_...  # /api/webhooks/invoice-payments/stripe (falls back to STRIPE_WEBHOOK_SECRET)
# TELR_STORE_ID=
# TELR_AUTH_KEY=

# --- Email outbox, bounces and push (W4-D) ---
# RESEND_API_KEY=re_...
# RESEND_FROM="Muhasib <billing@example.com>"
# RESEND_WEBHOOK_SECRET=whsec_...       # Svix secret for /api/webhooks/email-events/resend
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=billing@example.com
# EMAIL_DSN_WEBHOOK_SECRET=             # x-webhook-secret for /api/webhooks/email-events/smtp-dsn
# Web push (unset => push reported as requires_external / disabled).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# SMS (unset => SMS reminders report requires_external).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMS_SENDER_ID=

# --- Uploads antivirus (unset => scanning reports requires_external) ---
# CLAMAV_HOST=clamav.internal
# CLAMAV_PORT=3310

# --- Regulatory news feed (unset => curated/empty feed, hourly ingest is a no-op) ---
# NEWS_FEED_URLS=https://example.gov.ae/rss.xml,https://news.example.com/feed

# --- Bank feeds (W3-C) — adapters stay requires_external without credentials ---
# BANK_FEED_REDIRECT_URIS=https://app.example.com/banking/callback   # allow-list for OAuth redirects
# LEAN_API_BASE_URL=
# LEAN_APP_TOKEN=
# TARABUT_API_BASE_URL=
# TARABUT_CLIENT_ID=
# TARABUT_CLIENT_SECRET=
# WIO_API_BASE_URL=
# WIO_CLIENT_ID=
# WIO_CLIENT_SECRET=

# --- AI caps and models (W1-D) ---
# AI_MODEL_CATEGORIZE=
# AI_MODEL_OCR=
# AI_MODEL_ADVISORY=
# AI_MODEL_NL=
# ANTHROPIC_API_KEY=
# Default per-company monthly caps; ai_usage_limits rows override.
# AI_MONTHLY_TOKEN_CAP=
# AI_MONTHLY_COST_CAP_USD=
# AI_REDACT_PII=true
