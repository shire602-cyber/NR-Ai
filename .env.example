# ============================================
# Muhasib.ai Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.

# === Required ===
DATABASE_URL=postgresql://user:password@host:5432/muhasib_db
SESSION_SECRET=your-session-secret-at-least-32-characters-long
JWT_SECRET=your-jwt-secret-at-least-32-characters-long-different-from-session

# === Server ===
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of additional allowed browser origins for split frontend/backend deployments.
# CORS_ORIGIN=http://localhost:5173,https://app.example.com
# Production default is SameSite=None so separate frontend/backend origins can keep sessions.
# AUTH_COOKIE_SAMESITE=none

# === AI (OpenAI API) ===
OPENAI_API_KEY=sk-your-openai-api-key
AI_MODEL=gpt-3.5-turbo

# === Google Sheets Integration (Option 1: Service Account) ===
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === Google Sheets Integration (Option 2: OAuth2) ===
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# === UAE e-invoicing (Accredited Service Provider) ===
# Under Ministerial Decision 64/2025 only an MoF-accredited service provider may
# transmit UAE e-invoices. Muhasib generates compliant PINT AE / UBL 2.1 XML and
# hands it to that provider.
#
# "mock" fabricates an acceptance response — fine for dev and tests, and REFUSED
# in production so nobody can believe an invoice was transmitted when it wasn't.
#
# To go live: sign with an accredited ASP, then set EINVOICE_PROVIDER=http plus
# the two credentials below. No code change required.
# EINVOICE_PROVIDER=http
# EINVOICE_API_BASE_URL=https://api.your-asp.ae/v1
# EINVOICE_API_KEY=your-asp-api-key
# EINVOICE_API_AUTH_STYLE=bearer      # bearer (default) | header
# EINVOICE_API_KEY_HEADER=x-api-key   # used when auth style = header
# EINVOICE_API_TIMEOUT_MS=20000

# === Logging ===
LOG_LEVEL=info

# === Billing & Webhooks ===
# Billing tier enforcement. Default: automatic — production enforces tiers
# once Stripe is configured, and runs open (with a startup warning) before
# that, so pre-billing betas need no flag. Set true/false to override in
# either direction. Non-production defaults to open.
# BILLING_ENFORCEMENT=true
# Allow webhook URLs pointing at private/loopback addresses (self-hosted or
# local webhook receivers only — disables SSRF range checks).
# WEBHOOK_ALLOW_PRIVATE_URLS=false

# === Rate limits (requests per minute per ip:user; see server/middleware/rateLimit.ts) ===
# RL_API_MAX=100        # writes
# RL_READ_MAX=600       # GET/HEAD
# RL_AUTH_MAX=5         # failed credential attempts
# RL_AI_MAX=20
# The live-server integration scripts (tests/integration/*.mjs) read the same
# RL_* values and wait out 429s using Retry-After instead of skipping.

# === Test harness (npm run test:db) ===
# Admin URL used to CREATE/DROP per-run harness_* databases. Defaults to this
# file's DATABASE_URL with the database name replaced by "postgres". The harness
# never loads .env into the app and never touches the database named above.
# TEST_DATABASE_ADMIN_URL=postgresql://user:password@localhost:5432/postgres
# HARNESS_MAX_WORKERS=2
# HARNESS_LOG_LEVEL=fatal

# ─── Identity, RBAC and throttling (W2-C) ────────────────────────────
# Reverse-proxy hops in front of the app, used for req.ip and per-IP rate
# limits. Railway/Render: 1. CDN + load balancer: 2. Directly reachable: 0
# (X-Forwarded-For ignored). An Express trust list such as
# "loopback, 10.0.0.0/8" also works. "true" is refused. Unset = 1, with a
# warning in production.
# TRUST_PROXY_HOPS=1
# Central company-role policy (server/middleware/companyRolePolicy.ts).
# enforce (default) | report (log what would be denied, deny nothing) | off.
# Staged rollout: deploy with report, review "RBAC (report mode)" logs,
# then switch to enforce.
# RBAC_ENFORCE=enforce
# Per email+IP sign-in lockout: 5 failures in 15 min, then 10 in 1 h.
# RL_LOGIN_LOCK_MAX=5
# RL_LOGIN_LOCK_WINDOW_MS=900000
# RL_LOGIN_LOCK_LONG_MAX=10
# RL_LOGIN_LOCK_LONG_WINDOW_MS=3600000
# Optional override for the offline common-password list (top 10k).
# COMMON_PASSWORDS_FILE=server/assets/common-passwords.txt
