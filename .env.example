# ============================================
# Muhasib.ai Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.

# === Required ===
DATABASE_URL=postgresql://user:password@host:5432/muhasib_db
SESSION_SECRET=your-session-secret-at-least-32-characters-long
JWT_SECRET=your-jwt-secret-at-least-32-characters-long-different-from-session

# === Server ===
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Comma-separated list of additional allowed browser origins for split frontend/backend deployments.
# CORS_ORIGIN=http://localhost:5173,https://app.example.com
# Production default is SameSite=None so separate frontend/backend origins can keep sessions.
# AUTH_COOKIE_SAMESITE=none

# === AI (OpenAI API) ===
OPENAI_API_KEY=sk-your-openai-api-key
AI_MODEL=gpt-3.5-turbo

# === Google Sheets Integration (Option 1: Service Account) ===
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# === Google Sheets Integration (Option 2: OAuth2) ===
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# === UAE e-invoicing (Accredited Service Provider) ===
# Under Ministerial Decision 64/2025 only an MoF-accredited service provider may
# transmit UAE e-invoices. Muhasib generates compliant PINT AE / UBL 2.1 XML and
# hands it to that provider.
#
# "mock" fabricates an acceptance response — fine for dev and tests, and REFUSED
# in production so nobody can believe an invoice was transmitted when it wasn't.
#
# To go live: sign with an accredited ASP, then set EINVOICE_PROVIDER=http plus
# the two credentials below. No code change required.
# EINVOICE_PROVIDER=http
# EINVOICE_API_BASE_URL=https://api.your-asp.ae/v1
# EINVOICE_API_KEY=your-asp-api-key
# EINVOICE_API_AUTH_STYLE=bearer      # bearer (default) | header
# EINVOICE_API_KEY_HEADER=x-api-key   # used when auth style = header
# EINVOICE_API_TIMEOUT_MS=20000

# === Logging ===
LOG_LEVEL=info

# === Billing & Webhooks ===
# Billing tier enforcement. Default: automatic — production enforces tiers
# once Stripe is configured, and runs open (with a startup warning) before
# that, so pre-billing betas need no flag. Set true/false to override in
# either direction. Non-production defaults to open.
# BILLING_ENFORCEMENT=true
# Allow webhook URLs pointing at private/loopback addresses (self-hosted or
# local webhook receivers only — disables SSRF range checks).
# WEBHOOK_ALLOW_PRIVATE_URLS=false
